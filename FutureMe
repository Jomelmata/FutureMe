<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Future Letter</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f7f4ee;
      color: #333;
      line-height: 1.6;
    }

    /* NAVIGATION */
    nav {
      width: 100%;
      padding: 22px 7%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: white;
      border-bottom: 1px solid #eee;
    }

    .logo {
      font-size: 27px;
      font-weight: bold;
      color: #222;
    }

    .logo span {
      color: #e86f51;
    }

    nav a {
      text-decoration: none;
      color: #555;
      margin-left: 25px;
      font-size: 14px;
    }

    nav a:hover {
      color: #e86f51;
    }

    /* HERO */
    .hero {
      text-align: center;
      padding: 70px 20px 35px;
    }

    .hero h1 {
      font-family: Georgia, serif;
      font-size: 48px;
      font-weight: normal;
      margin-bottom: 15px;
      color: #292929;
    }

    .hero p {
      color: #777;
      font-size: 18px;
    }

    /* MAIN */
    .container {
      max-width: 1000px;
      margin: 20px auto 80px;
      padding: 0 20px;
    }

    .letter-card {
      background: white;
      border-radius: 12px;
      padding: 35px;
      box-shadow: 0 5px 25px rgba(0,0,0,0.08);
    }

    .letter-card h2 {
      font-family: Georgia, serif;
      font-size: 25px;
      margin-bottom: 20px;
    }

    textarea {
      width: 100%;
      min-height: 280px;
      resize: vertical;
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 18px;
      font-family: Georgia, serif;
      font-size: 17px;
      line-height: 1.7;
      outline: none;
    }

    textarea:focus,
    input:focus,
    select:focus {
      border-color: #e86f51;
    }

    .inspire {
      margin-top: 10px;
      border: none;
      background: none;
      color: #e86f51;
      cursor: pointer;
      font-size: 14px;
    }

    /* OPTIONS */
    .options {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 25px;
      margin-top: 30px;
    }

    .option-box {
      background: #fafafa;
      border: 1px solid #e4e4e4;
      border-radius: 8px;
      padding: 20px;
    }

    .option-box h3 {
      font-size: 15px;
      margin-bottom: 12px;
      color: #555;
    }

    select,
    input[type="email"],
    input[type="date"] {
      width: 100%;
      padding: 13px;
      border: 1px solid #ddd;
      border-radius: 6px;
      background: white;
      font-size: 15px;
      outline: none;
    }

    .radio-group {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
    }

    .radio-group label {
      font-size: 14px;
      cursor: pointer;
    }

    .email-section {
      margin-top: 25px;
    }

    .email-section label {
      display: block;
      font-weight: bold;
      font-size: 14px;
      margin-bottom: 8px;
    }

    /* BUTTON */
    .send-button {
      display: block;
      width: 100%;
      margin-top: 30px;
      padding: 16px;
      border: none;
      border-radius: 7px;
      background: #e86f51;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.2s;
    }

    .send-button:hover {
      background: #d95d40;
      transform: translateY(-1px);
    }

    /* FEATURES */
    .features {
      margin-top: 60px;
      text-align: center;
    }

    .features h2 {
      font-family: Georgia, serif;
      font-size: 30px;
      margin-bottom: 30px;
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 15px;
    }

    .feature {
      background: white;
      padding: 25px 15px;
      border-radius: 10px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.05);
    }

    .feature .icon {
      font-size: 30px;
      margin-bottom: 10px;
    }

    .feature p {
      font-size: 14px;
      color: #666;
    }

    /* FOOTER */
    footer {
      background: #292929;
      color: #ccc;
      text-align: center;
      padding: 35px 20px;
      margin-top: 70px;
    }

    footer .footer-logo {
      color: white;
      font-size: 22px;
      font-weight: bold;
      margin-bottom: 10px;
    }

    footer p {
      font-size: 13px;
    }

    /* MOBILE */
    @media (max-width: 700px) {

      nav {
        flex-direction: column;
        gap: 15px;
      }

      nav a {
        margin: 0 8px;
      }

      .hero h1 {
        font-size: 36px;
      }

      .options {
        grid-template-columns: 1fr;
      }

      .feature-grid {
        grid-template-columns: 1fr 1fr;
      }

      .letter-card {
        padding: 20px;
      }
    }
  </style>
</head>

<body>

  <!-- NAVIGATION -->
  <nav>
    <div class="logo">future<span>letter</span></div>

    <div>
      <a href="#">Write a Letter</a>
      <a href="#">Read Letters</a>
      <a href="#">Sign In</a>
    </div>
  </nav>


  <!-- HERO -->
  <section class="hero">
    <h1>Write a letter to your future self</h1>

    <p>
      Write. Pick a date. Send. Let your future self discover it.
    </p>
  </section>


  <!-- LETTER FORM -->
  <main class="container">

    <div class="letter-card">

      <h2>Your Future Letter</h2>

      <textarea id="letter">Dear FutureMe,

I hope you are doing well. I am writing this letter to remind you of who you are today, your dreams, your goals, and the things that matter to you.

I hope you never stop believing in yourself.

Sincerely,
Your Past Self</textarea>

      <button class="inspire" onclick="inspireMe()">
        ✨ Inspire me!
      </button>


      <!-- OPTIONS -->
      <div class="options">

        <div class="option-box">

          <h3>DELIVER IN</h3>

          <select id="duration">
            <option value="6 months">6 months</option>
            <option value="1 year">1 year</option>
            <option value="3 years">3 years</option>
            <option value="5 years">5 years</option>
            <option value="10 years">10 years</option>
          </select>

        </div>


        <div class="option-box">

          <h3>OR CHOOSE A DATE</h3>

          <input type="date" id="date">

        </div>


        <div class="option-box">

          <h3>SELECT YOUR AUDIENCE</h3>

          <div class="radio-group">

            <label>
              <input type="radio" name="audience" checked>
              Private
            </label>

            <label>
              <input type="radio" name="audience">
              Public, but anonymous
            </label>

          </div>

        </div>


        <div class="option-box">

          <h3>WORD COUNT</h3>

          <p id="wordCount">0 words</p>

        </div>

      </div>


      <!-- EMAIL -->
      <div class="email-section">

        <label for="email">
          MAKE SURE YOU GET YOUR LETTER
        </label>

        <input
          type="email"
          id="email"
          placeholder="Please enter your email"
        >

      </div>


      <!-- SEND -->
      <button class="send-button" onclick="sendLetter()">
        Send to the Future 🚀
      </button>

    </div>


    <!-- FEATURES -->
    <section class="features">

      <h2>Future letters are great for…</h2>

      <div class="feature-grid">

        <div class="feature">
          <div class="icon">❤️</div>
          <p>Reliving memories in vivid detail</p>
        </div>

        <div class="feature">
          <div class="icon">📈</div>
          <p>Acknowledging your growth and achievements</p>
        </div>

        <div class="feature">
          <div class="icon">✅</div>
          <p>Setting goals for your future</p>
        </div>

        <div class="feature">
          <div class="icon">😌</div>
          <p>Clearing your mind and reflecting</p>
        </div>

      </div>

    </section>

  </main>


  <!-- FOOTER -->
  <footer>

    <div class="footer-logo">futureletter</div>

    <p>
      A simple demo inspired by future-letter websites.
    </p>

    <p>
      © 2026 Future Letter Demo
    </p>

  </footer>


  <!-- JAVASCRIPT -->
  <script>

    const letter = document.getElementById("letter");
    const wordCount = document.getElementById("wordCount");

    function updateWordCount() {

      const words = letter.value
        .trim()
        .split(/\s+/)
        .filter(word => word.length > 0);

      wordCount.textContent = words.length + " words";
    }

    letter.addEventListener("input", updateWordCount);

    updateWordCount();


    function inspireMe() {

      const ideas = [
        "What do you hope your future self has accomplished?",
        "What is your biggest dream right now?",
        "What are you grateful for today?",
        "What advice would you give your future self?",
        "Where do you hope to be in five years?"
      ];

      const random =
        ideas[Math.floor(Math.random() * ideas.length)];

      letter.value += "\n\n" + random + "\n";

      updateWordCount();
    }


    function sendLetter() {

      const email =
        document.getElementById("email").value;

      const message =
        letter.value.trim();

      if (message.length === 0) {
        alert("Please write a letter first.");
        return;
      }

      if (email.length === 0) {
        alert("Please enter your email.");
        return;
      }

      alert(
        "Demo only! Your letter has been prepared for the future. 🚀"
      );
    }

  </script>

</body>
</html>
